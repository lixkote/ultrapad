<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UltraPad"
      xmlns:helpers="using:UltraPad.Helpers"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
      xmlns:my="using:UltraPad.UltraPadUI"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:primitives="using:Windows.UI.Xaml.Controls.Primitives"
      xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals" xmlns:Custom="using:UltraPad.UltraPadUI.Ribbon" xmlns:transformers="using:FanKit.Transformers" xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml" x:Class="UltraPad.MainPage"
      mc:Ignorable="d"
      muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
      >


    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SystemColorButtonFaceColorBrush" />
                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SystemColorGrayTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <DataTemplate x:Key="ComboBoxItemTemplate">
                <!-- Your template here -->
            </DataTemplate>
            <helpers:ZoomConverter x:Key="ZoomConverter"/>
            <helpers:HalfValueConverter x:Key="HalfValueConverter"/>
            <Flyout x:Key="myColorPickerFlyout">
                <RelativePanel>
                    <ColorPicker x:Name="myColorPicker"
                             IsColorChannelTextInputVisible="True"
                             IsHexInputVisible="True"/>
                </RelativePanel>
            </Flyout>
                <Style x:Key="PaintScrollArrowStyle" TargetType="RepeatButton">
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Interval" Value="50" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RepeatButton">
                                <Grid Background="Transparent">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="Arrow.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="Arrow.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="Arrow.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <ContentPresenter x:Name="Arrow"
                                                      Content="{TemplateBinding Content}"
                                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      FontSize="8"
                                                      Foreground="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="PaintScrollPageStyle" TargetType="RepeatButton">
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Interval" Value="50" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RepeatButton">
                                <Grid Background="Transparent" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="PaintScrollThumbStyle" TargetType="Thumb">
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="ThumbVisual.Fill" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="ThumbVisual.Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="ThumbVisual.Fill" Value="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Rectangle x:Name="ThumbVisual"
                                               Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                               RadiusX="3"
                                               RadiusY="3" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="PaintScrollBarStyle" TargetType="primitives:ScrollBar">
                    <Setter Property="MinWidth" Value="12" />
                    <Setter Property="MinHeight" Value="12" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="primitives:ScrollBar">
                                <Grid x:Name="Root">
                                    <Grid x:Name="HorizontalRoot" Height="12" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="5" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        <RepeatButton x:Name="HorizontalSmallDecrease" Grid.Column="0" Width="12" Height="12" Content="&#xEDD9;" Style="{StaticResource PaintScrollArrowStyle}" />
                                        <RepeatButton x:Name="HorizontalLargeDecrease" Grid.Column="1" Width="0" Height="12" Style="{StaticResource PaintScrollPageStyle}" />
                                        <Thumb x:Name="HorizontalThumb" Grid.Column="2" Height="6" MinWidth="24" VerticalAlignment="Center" Style="{StaticResource PaintScrollThumbStyle}" AutomationProperties.AccessibilityView="Raw" />
                                        <RepeatButton x:Name="HorizontalLargeIncrease" Grid.Column="3" Height="12" Style="{StaticResource PaintScrollPageStyle}" />
                                        <RepeatButton x:Name="HorizontalSmallIncrease" Grid.Column="4" Width="12" Height="12" Content="&#xEDDA;" Style="{StaticResource PaintScrollArrowStyle}" />
                                    </Grid>
                                    <Grid x:Name="VerticalRoot" Width="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.RowSpan="5" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        <RepeatButton x:Name="VerticalSmallDecrease" Grid.Row="0" Width="12" Height="12" Content="&#xEDDB;" Style="{StaticResource PaintScrollArrowStyle}" />
                                        <RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" Width="12" Height="0" Style="{StaticResource PaintScrollPageStyle}" />
                                        <Thumb x:Name="VerticalThumb" Grid.Row="2" Width="6" MinHeight="24" HorizontalAlignment="Center" Style="{StaticResource PaintScrollThumbStyle}" AutomationProperties.AccessibilityView="Raw" />
                                        <RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3" Width="12" Style="{StaticResource PaintScrollPageStyle}" />
                                        <RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Width="12" Height="12" Content="&#xEDDC;" Style="{StaticResource PaintScrollArrowStyle}" />
                                    </Grid>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            <!-- the page scroll viewer like the new Paint: bars sit next to the page (not over it),
                 are always fully shown with arrows and a thin rounded thumb, and never collapse -->
            <Style x:Key="PaintScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <primitives:ScrollBar x:Name="VerticalScrollBar"
                                                      Grid.Column="1"
                                                      Margin="2,2,2,2"
                                                      Orientation="Vertical"
                                                      IndicatorMode="MouseIndicator"
                                                      IsTabStop="False"
                                                      Maximum="{TemplateBinding ScrollableHeight}"
                                                      ViewportSize="{TemplateBinding ViewportHeight}"
                                                      Value="{TemplateBinding VerticalOffset}"
                                                      Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                      Style="{StaticResource PaintScrollBarStyle}" />
                                <primitives:ScrollBar x:Name="HorizontalScrollBar"
                                                      Grid.Row="1"
                                                      Margin="2,2,2,2"
                                                      Orientation="Horizontal"
                                                      IndicatorMode="MouseIndicator"
                                                      IsTabStop="False"
                                                      Maximum="{TemplateBinding ScrollableWidth}"
                                                      ViewportSize="{TemplateBinding ViewportWidth}"
                                                      Value="{TemplateBinding HorizontalOffset}"
                                                      Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                      Style="{StaticResource PaintScrollBarStyle}" />
                                <Border x:Name="ScrollBarSeparator" Grid.Row="1" Grid.Column="1" Background="Transparent" />
                                <ScrollContentPresenter x:Name="ScrollContentPresenter"
                                                        Margin="{TemplateBinding Padding}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="181*"/>
            <ColumnDefinition Width="44"/>
        </Grid.ColumnDefinitions>
        <VisualStateManager.VisualStateGroups>
