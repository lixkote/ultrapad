        <Grid.RowDefinitions>
            <RowDefinition Height="12" />
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Background="Transparent" Grid.RowSpan="2" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="/Assets/rpad16.png"
                   Width="16"
                   Height="16"
                   Grid.Column="1" />
            <TextBlock
                       x:Name="AppTitle"                       
                       x:Uid="apptitle"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Grid.Column="3" Text="Document - UltraPad"/>
        </Grid>

        <StackPanel x:Name="MenuStack"
                    Grid.Row="2" Grid.ColumnSpan="3"
                    Orientation="Horizontal">
            <muxc:MenuBar>
                <muxc:MenuBarItem Title="File" x:Uid="filemenuitem" x:Name="FileMenuRoot" AccessKey="F">
                    <MenuFlyoutItem Text="New" Click="NewDoc_Click" x:Uid="new" AccessKey="N">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A5;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N"
                                                 Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Open" x:Uid="openmenuitem" AccessKey="O"
                                    Click="Open_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE838;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O"
                                                 Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem Text="Recent" x:Uid="recentmenuitem" x:Name="RecentItemsSubItem" AccessKey="R">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE823;" />
                        </MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem Text="Save" x:Uid="savemenuitem" AccessKey="S" Click="SaveButton_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74E;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S"
                                                 Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem Text="Save as" x:Uid="saveasmenuitem" AccessKey="A">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE792;" />
                        </MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem AccessKey="R" Text="RTF" x:Uid="saveasrtf" x:Name="SaveAsRTF" Click="SaveAsRTF_Click"/>
                        <MenuFlyoutItem AccessKey="D" Text="DOCX" x:Uid="saveasdocx" x:Name="SaveAsDOCX" Click="SaveAsDOCX_Click"/>
                        <MenuFlyoutItem AccessKey="O" Text="ODT" x:Uid="saveasodt" x:Name="SaveAsODT" Click="SaveAsODT_Click"/>
                        <MenuFlyoutItem AccessKey="T" Text="TXT"  x:Uid="saveastxt" x:Name="SaveAsTXT" Click="SaveAsTXT_Click"/>
                        <MenuFlyoutItem AccessKey="F" Text="Other format" x:Uid="saveasothersub" x:Name="SaveAsOther" Tag="ALL" Click="SaveAsFormat_Click"/>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem x:Name="PrintSubItem" AccessKey="P" x:Uid="printmfsi" Text="Print">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE749;" />
                        </MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem Text="Print" x:Uid="printmfsi" AccessKey="P" Click="MenuFlyoutItem_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="P"
                                                     Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="QuickPrint" AccessKey="Q" Text="Quick print" x:Uid="qprint" Click="QuickPrint_Click"/>
                        <MenuFlyoutItem Text="Print preview" x:Name="pintpreview" AccessKey="V" x:Uid="printpreview" Click="pintpreview_Click"/>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem Text="Page setup" x:Uid="pgset" x:Name="PageSetupMenuItem" AccessKey="U" Click="PageSetupMenuItem_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="sharebuttonmenu" AccessKey="H" Click="SendButton_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72D;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator></MenuFlyoutSeparator>
                    <MenuFlyoutItem x:Name="CloseMenuFlyoutItem" AccessKey="X" x:Uid="closebuttonmenu" Click="CloseMenuFlyoutItem_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </muxc:MenuBarItem>
                <muxc:MenuBarItem Title="Edit" x:Uid="edit" AccessKey="E">
                    <MenuFlyoutItem x:Uid="menu_cut" Text="Cut" AccessKey="T" Click="Cut_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="X"
                                                 Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Copy" x:Uid="copy" AccessKey="C" Click="Copy_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="C"
                                                 Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Paste" x:Uid="paste" AccessKey="P" Click="MenuPaste_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="V"
                                                 Modifiers="Control" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </muxc:MenuBarItem>
                <muxc:MenuBarItem Title="View" x:Uid="view" AccessKey="V">
                    <MenuFlyoutSubItem Text="Zoom" x:Uid="vw_zoom" AccessKey="Z">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE8A3;" />
                        </MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem x:Name="Zoom100MenuItem" Text="100%" Click="Zoom100_Click" IsEnabled="False">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number0" Modifiers="Control" />
