                    <ComboBox x:Name="ZoomComboBox" AccessKey="ZC" Margin="0,4,8,4"
                              FontSize="12"
                              VerticalAlignment="Center"
                              IsEditable="True" Width="88"
                              SelectionChanged="ZoomComboBox_SelectionChanged"
                              TextSubmitted="ZoomComboBox_TextSubmitted" />


                    <Button Style="{StaticResource PaintUIButtonStyle}"
            FontSize="14"
            x:Name="DecreaseZoomButton"
            Click="DecreaseZoomButton_Click"
            Margin="4"
            Width="32"
                                        CornerRadius="2"
            Height="20"
            VerticalAlignment="Stretch"
            x:Uid="zoomoutbutton" AccessKey="ZO" ToolTipService.ToolTip="Zoom out">
                        <Image x:Name="pastesimgfull" Width="16"
                   Height="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Source="{ThemeResource ResourceKey=ZoomOut}" Stretch="Fill" />
                    </Button>

                    <!--
    
    Did you ever notice that the slider's thumb in paint, is slightly clipped when the thumb is
    near the edge of the slider?
    
    yeah that happens here too, not sure why tho
    
    -->
                    <Slider x:Name="ZoomSlider" Width="130" Maximum="3" Minimum="0.25" Value="1" ValueChanged="ZoomSlider_ValueChanged" TickPlacement="None" TickFrequency="0.25" StepFrequency="0.1" IsThumbToolTipEnabled="False" VerticalAlignment="Center"/>


                    <Button Style="{StaticResource PaintUIButtonStyle}"
            FontSize="14"
            x:Name="IncreaseZoomButton"
            Margin="4"
                        CornerRadius="2"
            Height="20"
            Width="32"
            Click="IncreaseZoomButton_Click"
            VerticalAlignment="Stretch"
            x:Uid="zoominbutton" AccessKey="ZI" ToolTipService.ToolTip="Zoom in">
                        <Image x:Name="zoomimgplys" Width="16"
                   Height="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Source="{ThemeResource ResourceKey=ZoomIn}" />
                    </Button>

                </StackPanel>
            </Grid>


        </Border>

        <Grid x:Name="PrintPreviewHost" Grid.Row="4" Grid.RowSpan="2" Grid.ColumnSpan="3" Visibility="Collapsed" Canvas.ZIndex="30"
              Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="PrintPreviewScroller" ZoomMode="Disabled" IsTabStop="True" UseSystemFocusVisuals="False"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PrintPreviewPages" Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ScrollViewer>
            <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="PrintPreviewPageText" Margin="12,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Border>
            <ProgressRing x:Name="PrintPreviewProgress" Width="32" Height="32" IsActive="False"
                          HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>

        <Grid x:Name="PrintCanvasHost" Grid.Row="4" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"
              IsHitTestVisible="False" />

    </Grid>
</Page>
