<UserControl
    x:Class="UltraPad.UltraPadUI.Ribbon.FontToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:UltraPad.UltraPadUI.Ribbon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="120"
    d:DesignWidth="430"
    Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Flyout x:Key="myColorPickerFlyout">
            <RelativePanel>
                <ColorPicker
                    x:Name="myColorPicker"
                    IsColorChannelTextInputVisible="False"
                    IsHexInputVisible="True" />

                <Grid
                    RelativePanel.AlignLeftWithPanel="True"
                    RelativePanel.AlignRightWithPanel="True"
                    RelativePanel.Below="myColorPicker">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button
                        Margin="0,12,2,0"
                        HorizontalAlignment="Stretch"
                        Click="ConfirmColor_Click"
                        x:Uid="fc_ok" Content="OK" Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        Grid.Column="1"
                        Margin="2,12,0,0"
                        HorizontalAlignment="Stretch"
                        Click="CancelColor_Click"
                        x:Uid="fc_cancel" Content="Cancel" />
                </Grid>
            </RelativePanel>
        </Flyout>
    </UserControl.Resources>

    <Grid x:Name="RootFontGrid" BorderBrush="{ThemeResource RibbonColumnBorder}"
      BorderThickness="0,0,0,0"
      Grid.Column="1">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="72" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="FontGridExpanded" BorderBrush="{ThemeResource RibbonColumnBorder}"
      BorderThickness="0,0,0,0"
      Grid.Column="1" HorizontalAlignment="1" VerticalAlignment="1">


            <Grid RowSpacing="8" ColumnSpacing="8" Margin="0,4,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="77"/>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource PaintUIButtonStyle}"
                Content="&#xe8d2;"
                Width="32"
                MinWidth="32"
                MaxWidth="32"
                Height="32"
                Grid.Column="0"
                Grid.Row="0"
                Visibility="Collapsed"/>


                <Button x:Name="FontEnlargeButton" AccessKey="NG" Style="{StaticResource PaintUIButtonStyle}"
                Width="32"
                MinWidth="32"
                MaxWidth="32"
                FontFamily="{StaticResource SegoeFluentIcons}"
                Height="32"
                Grid.Column="6"
                FontSize="20" Click="FontEnlargeButton_Click" Margin="19,0,0,0" RenderTransformOrigin="0.836,0.508">
                    <Button.Content>
                        <Image Width="16" Height="16" Source="{ThemeResource FontIncrease}" />
                    </Button.Content>
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="tt_fontgrow" Content="Grow font" />
                    </ToolTipService.ToolTip>
                </Button>

                <Button x:Name="FontDislargeButton" AccessKey="NK" Style="{StaticResource PaintUIButtonStyle}"
                Width="32"
                MinWidth="32"
                MaxWidth="32"
                Height="32"
                FontFamily="{StaticResource SegoeFluentIcons}"
                Grid.Column="6"
                FontSize="20" Click="FontDislargeButton_Click" Margin="57,0,0,0" RenderTransformOrigin="0.57,0.492">
                    <Button.Content>
                        <Image Width="16" Height="16" Source="{ThemeResource FontDecrease}" />
                    </Button.Content>
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="tt_fontshrink" Content="Shrink font" />
                    </ToolTipService.ToolTip>
                </Button>


                <ToggleButton x:Name="TextBoldButton" AccessKey="BO" Style="{StaticResource PaintUIToggleButtonStyle}"
                      Content="&#xe8dd;"
                      FontFamily="{StaticResource SegoeFluentIcons}"
                      Width="32"
                      Height="32"
                      Grid.Column="0"
                      Grid.Row="1" Click="TextBoldButton_Click">
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="tt_bold" Content="Bold" />
                    </ToolTipService.ToolTip>
                </ToggleButton>


                <ToggleButton x:Name="TextItalicButton" AccessKey="IT" Style="{StaticResource PaintUIToggleButtonStyle}"
                      Content="&#xe8db;"
                      FontFamily="{StaticResource SegoeFluentIcons}"
                      Width="32"
                      Height="32"
                      Grid.Column="1"
                      Grid.Row="1" Click="TextItalicButton_Click">
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="tt_italic" Content="Italic" />
                    </ToolTipService.ToolTip>
                </ToggleButton>


                <ToggleButton x:Name="TextUnderlineButton" AccessKey="UL" Style="{StaticResource PaintUIToggleButtonStyle}"
                      Content="&#xe8dc;"
                      Width="32"
                                                FontFamily="{StaticResource SegoeFluentIcons}"
                      Height="32"
                      Grid.Column="2"
                      Grid.Row="1" Click="TextUnderlineButton_Click">
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="tt_underline" Content="Underline" />
                    </ToolTipService.ToolTip>
                </ToggleButton>


                <ToggleButton x:Name="TextStrikethroughButton" AccessKey="SK" Style="{StaticResource PaintUIToggleButtonStyle}"
                      Content="&#xede0;"
                      FontFamily="{StaticResource SegoeFluentIcons}"
                      Width="32"
                      Height="32"
                      Grid.Column="3"
                      Grid.Row="1" Click="TextStrikethroughButton_Click">
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="tt_strike" Content="Strikethrough" />
                    </ToolTipService.ToolTip>
                </ToggleButton>

                <ToggleButton x:Name="TextSubscriptButton" AccessKey="SB" Style="{StaticResource PaintUIToggleButtonStyle}"
                     Padding="0"
                     Width="32"
                     MinWidth="32"
                     MaxWidth="32"
                     Height="32"
                     Grid.Column="4"
                     Grid.Row="1"
                     Margin="2,0,0,0" Grid.ColumnSpan="2" Click="TextSubscriptButton_Click">
                    <ToggleButton.Content>
                        <Image Width="16" Height="16" Source="{ThemeResource BottomScript}" />
                    </ToggleButton.Content>
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="tt_subscript" Content="Subscript" />
                    </ToolTipService.ToolTip>
                </ToggleButton>

                <ToggleButton x:Name="TextSuperscriptButton" AccessKey="SP" Style="{StaticResource PaintUIToggleButtonStyle}"
                     Padding="0"
                     Width="32"
                     MinWidth="32"
                     MaxWidth="32"
                     Height="32"
                     Grid.Column="5"
                     Grid.Row="1"
                     Margin="-40,0,0,0" Grid.ColumnSpan="2" Click="TextSuperscriptButton_Click" FontFamily="UltraPad Fluent Icons">
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="tt_superscript" Content="Superscript" />
                    </ToolTipService.ToolTip>
                    <ToggleButton.Content>
                        <Image Width="16" Height="16" Source="{ThemeResource UpScript}" />
                    </ToggleButton.Content>
                </ToggleButton>
                <ComboBox x:Name="FontsComboBox" AccessKey="NF" Loaded="FontsComboBox_Loaded" ItemsSource="{Binding Fonts}" SelectionChanged="FontsCombo_SelectionChanged" Grid.Column="0" Grid.ColumnSpan="5" HorizontalAlignment="Stretch" IsEditable="True" Margin="0,0,40,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock FontFamily="{x:Bind}" Text="{x:Bind}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox x:Name="fontSizeComboBox" AccessKey="NS" Grid.Column="4" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" IsEditable="True" 
                               Margin="43,0,106,0" TextSubmitted="FontSizeCombo_TextSubmitted" ItemsSource="{x:Bind FontSizes}" PlaceholderText="" SelectionChanged="FontSizeCombo_SelectionChanged" SelectedIndex="3">
                </ComboBox>

                <muxc:SplitButton x:Name="FontTextColorDropDownButton" AccessKey="TC" Template="{StaticResource PaintUIHorizontalSplitButton}" Grid.Column="6" Margin="-38,0,0,0" Grid.Row="1" Width="77" FontFamily="UltraPad Fluent Icons" FontSize="20" Click="FontTextColorDropDownButton_Click" Height="27" Padding="0,0,0,0" UseLayoutRounding="True">
                    <muxc:SplitButton.Content>
                        <Grid>
                            <FontIcon x:Name="FontColorMarkerMain" Glyph="" FontSize="20" FontFamily="UltraPad Fluent Icons"></FontIcon>
                            <TextBlock x:Name="FontColorMarker" Text="&#xE8FC;" FontFamily="UltraPad Fluent Icons" FontSize="20" Foreground="Transparent"/>
                        </Grid>
                    </muxc:SplitButton.Content>
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="tt_textcolor" Content="Text color" />
                    </ToolTipService.ToolTip>
                    <muxc:SplitButton.Flyout>
                        <Flyout Placement="Bottom">
                            <RelativePanel>
                                <VariableSizedWrapGrid x:Name="colorGrid" MaximumRowsOrColumns="6" Orientation="Horizontal" RelativePanel.Below="Autobutton" Margin="0,4,0,4" />
                                <Button Style="{StaticResource PaintUIButtonStyle}" Flyout="{StaticResource myColorPickerFlyout}" RelativePanel.Below="colorGrid" RelativePanel.AlignLeftWithPanel="True" RelativePanel.AlignRightWithPanel="True" x:Name="colorPickerButton" HorizontalAlignment="Stretch" FontFamily="Segoe UI" FontSize="12" Height="36" Padding="8,0" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE790;" Width="24" FontSize="16" />
                                        <TextBlock x:Uid="morecolors" Text="More colors..." VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" RelativePanel.AlignLeftWithPanel="True" RelativePanel.AlignRightWithPanel="True" x:Name="Autobutton" Click="Autobutton_Click" Style="{StaticResource PaintUIButtonStyle}" FontFamily="Segoe UI" Height="36" Padding="8,0" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Ellipse Width="24" Height="24" Stroke="{ThemeResource PaintSwatchOutline}" StrokeThickness="1" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock x:Uid="Automatical" Text="Automatic" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </RelativePanel>
                        </Flyout>
                    </muxc:SplitButton.Flyout>
                </muxc:SplitButton>
                <muxc:SplitButton Template="{StaticResource PaintUIHorizontalSplitButton}" x:Name="FontBackgroundColorDropDownButton" AccessKey="TH" Grid.Column="6" Margin="43,0,0,0" Grid.Row="1" Width="77" FontFamily="UltraPad Fluent Icons" FontSize="20" Click="FontBackgroundColorDropDownButton_Click" Height="27" Padding="0,0,0.2,0">
                    <muxc:SplitButton.Content>
                        <Grid>
                            <FontIcon x:Name="BackTextColorMarkerMain" Glyph="&#xE8FF;" FontSize="20" ></FontIcon>
                            <TextBlock x:Name="BackTextColorMarker" Text="&#xE8FE;" FontSize="20" Foreground="Transparent"/>
                        </Grid>
                    </muxc:SplitButton.Content>
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="tt_highlight" Content="Text highlight color" />
                    </ToolTipService.ToolTip>
                    <muxc:SplitButton.Flyout>
                        <Flyout Placement="Bottom">
                            <RelativePanel>
                                <VariableSizedWrapGrid x:Name="colorGrid2" MaximumRowsOrColumns="5" Orientation="Horizontal" Margin="0,0,0,4" />
                                <Button RelativePanel.Below="colorGrid2" RelativePanel.AlignLeftWithPanel="True" RelativePanel.AlignRightWithPanel="True" Click="NoColorButton_Click" x:Name="NoColorButton" HorizontalAlignment="Stretch" Style="{StaticResource PaintUIButtonStyle}" Height="36" Padding="8,0" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Ellipse Width="24" Height="24" Fill="#FFCEE5FC" Stroke="#FF7EB5EB" StrokeThickness="1" />
                                        <TextBlock x:Uid="nocolor" Text="No color" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </RelativePanel>
                        </Flyout>
                    </muxc:SplitButton.Flyout>
                </muxc:SplitButton>


            </Grid>

        </Grid>
        <TextBlock x:Uid="FontToolbarTitle"
               Style="{StaticResource ColumnDescriptionTextblockStyle}"
               Grid.Row="1" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
