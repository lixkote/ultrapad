<UserControl
    x:Class="UltraPad.UltraPadUI.TextRuler"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UltraPad.UltraPadUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="40"
    d:DesignWidth="816">


    <UserControl.Resources>
        <Style x:Key="RulerTickStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="RulerDefaultTabStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Width" Value="2" />
            <Setter Property="Height" Value="2" />
            <Setter Property="RadiusX" Value="1" />
            <Setter Property="RadiusY" Value="1" />
        </Style>
        <Style x:Key="RulerLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Width" Value="30" />
        </Style>
        <Style x:Key="RulerTabPathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="RulerTabMarkStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RadiusX" Value="0.5" />
            <Setter Property="RadiusY" Value="0.5" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Canvas x:Name="RulerCanvas"
                Background="Transparent"
                PointerPressed="RulerCanvas_PointerPressed"
                PointerMoved="RulerCanvas_PointerMoved"
                PointerReleased="RulerCanvas_PointerReleased"
                PointerCaptureLost="RulerCanvas_PointerCaptureLost"
                DoubleTapped="RulerCanvas_DoubleTapped"
                SizeChanged="RulerCanvas_SizeChanged">

            <Border x:Name="PageBar"
                    Canvas.Top="6"
                    Height="26"
                    CornerRadius="4"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}" />

            <Border x:Name="TextArea"
                    Canvas.Top="7"
                    Height="24"
                    BorderThickness="1,0,1,0"
                    IsHitTestVisible="False"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}" />

            <Canvas x:Name="TickLayer" IsHitTestVisible="False" />
            <Canvas x:Name="TabLayer" IsHitTestVisible="False" />

            <Viewbox x:Name="FirstIndentMarker" Width="14" Height="12" Canvas.Top="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Viewbox.RenderTransform>
                    <ScaleTransform ScaleY="-1" />
                </Viewbox.RenderTransform>
                <Grid Width="20" Height="17">
                    <Path Data="F1 M 2 12 C 2 14 4 16 6 16 L 14 16 C 16 16 18 14 18 12 L 18 11 C 18 9 18 9 16 7 L 12 3 C 10 1 10 1 8 3 L 4 7 C 2 9 2 9 2 11 Z" Fill="{ThemeResource ControlSolidFillColorDefaultBrush}" />
                    <Path Data="F1 M 5 11 C 5 12 6 13 7 13 L 13 13 C 14 13 15 12 15 11 L 15 11 C 15 10 15 10 14 9 L 12 7 C 10 5 10 5 8 7 L 6 9 C 5 10 5 10 5 11 Z" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Path Data="F1 M 2 12 C 2 14 4 16 6 16 L 14 16 C 16 16 18 14 18 12 L 18 11 C 18 9 18 9 16 7 L 12 3 C 10 1 10 1 8 3 L 4 7 C 2 9 2 9 2 11 Z L 1 12 L 1 11 c 0 -2.5 0 -2.75 3 -5.5 L 7 2.5 C 10 -0.5 10 -0.5 13 2.5 L 17 6.5 C 19 8.3 19 8.5 19 11 L 19 12 C 19 15 17 17 14 17 L 6 17 C 3 17 1 15 1 12" Fill="{ThemeResource ControlElevationBorderBrush}" />
                </Grid>
            </Viewbox>

            <Viewbox x:Name="HangingIndentMarker" Width="14" Height="12" Canvas.Top="21" IsHitTestVisible="False">
                <Grid Width="20" Height="17">
                    <Path Data="F1 M 2 12 C 2 14 4 16 6 16 L 14 16 C 16 16 18 14 18 12 L 18 11 C 18 9 18 9 16 7 L 12 3 C 10 1 10 1 8 3 L 4 7 C 2 9 2 9 2 11 Z" Fill="{ThemeResource ControlSolidFillColorDefaultBrush}" />
                    <Path Data="F1 M 5 11 C 5 12 6 13 7 13 L 13 13 C 14 13 15 12 15 11 L 15 11 C 15 10 15 10 14 9 L 12 7 C 10 5 10 5 8 7 L 6 9 C 5 10 5 10 5 11 Z" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Path Data="F1 M 2 12 C 2 14 4 16 6 16 L 14 16 C 16 16 18 14 18 12 L 18 11 C 18 9 18 9 16 7 L 12 3 C 10 1 10 1 8 3 L 4 7 C 2 9 2 9 2 11 Z L 1 12 L 1 11 c 0 -2.5 0 -2.75 3 -5.5 L 7 2.5 C 10 -0.5 10 -0.5 13 2.5 L 17 6.5 C 19 8.3 19 8.5 19 11 L 19 12 C 19 15 17 17 14 17 L 6 17 C 3 17 1 15 1 12" Fill="{ThemeResource ControlElevationBorderBrush}" />
                </Grid>
            </Viewbox>

            <Border x:Name="LeftIndentMarker" Width="12" Height="6" Canvas.Top="33" IsHitTestVisible="False"
                    CornerRadius="2" BorderThickness="1"
                    Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlElevationBorderBrush}">
                <Rectangle Margin="2,1" RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            </Border>

            <Viewbox x:Name="RightIndentMarker" Width="14" Height="12" Canvas.Top="21" IsHitTestVisible="False">
                <Grid Width="20" Height="17">
                    <Path Data="F1 M 2 12 C 2 14 4 16 6 16 L 14 16 C 16 16 18 14 18 12 L 18 11 C 18 9 18 9 16 7 L 12 3 C 10 1 10 1 8 3 L 4 7 C 2 9 2 9 2 11 Z" Fill="{ThemeResource ControlSolidFillColorDefaultBrush}" />
                    <Path Data="F1 M 5 11 C 5 12 6 13 7 13 L 13 13 C 14 13 15 12 15 11 L 15 11 C 15 10 15 10 14 9 L 12 7 C 10 5 10 5 8 7 L 6 9 C 5 10 5 10 5 11 Z" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Path Data="F1 M 2 12 C 2 14 4 16 6 16 L 14 16 C 16 16 18 14 18 12 L 18 11 C 18 9 18 9 16 7 L 12 3 C 10 1 10 1 8 3 L 4 7 C 2 9 2 9 2 11 Z L 1 12 L 1 11 c 0 -2.5 0 -2.75 3 -5.5 L 7 2.5 C 10 -0.5 10 -0.5 13 2.5 L 17 6.5 C 19 8.3 19 8.5 19 11 L 19 12 C 19 15 17 17 14 17 L 6 17 C 3 17 1 15 1 12" Fill="{ThemeResource ControlElevationBorderBrush}" />
                </Grid>
            </Viewbox>
        </Canvas>
    </Grid>
</UserControl>
